DATABASE_URL="file:./dev.db"
JWT_SECRET="troque-esta-chave"

# Endereço do frontend web, usado no link do e-mail de redefinição de senha
FRONTEND_URL="http://localhost:3000"

# SMTP para enviar e-mails (opcional). Sem SMTP_HOST, o link de
# redefinição de senha aparece no console do servidor.
# SMTP_HOST="smtp.exemplo.com"
# SMTP_PORT="587"
# SMTP_USER="usuario"
# SMTP_PASS="senha"
# SMTP_FROM="Cinema <nao-responda@exemplo.com>"
